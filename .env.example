# =============================================================================
# Aegis Arena — скопируйте в .env. Не коммитить .env.
# Стек: docker compose -f docker-compose.second.yml
# Сайт: http://localhost:3002
# =============================================================================

# --- сайт и сессии ---
NEXTAUTH_URL=http://localhost:3002
APP_URL=http://localhost:3002
# Production: APP_URL=https://your.domain and NEXT_PUBLIC_SOCKET_URL=wss://your.domain:… (or same host path).
AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_SECRET=replace-with-a-long-random-string
NODE_ENV=development
LOG_LEVEL=info
NODE_OPTIONS=--max-old-space-size=4096

# --- UI ---
NEXT_PUBLIC_APP_NAME="Aegis Arena"
NEXT_PUBLIC_DEFAULT_LOCALE=ru
NEXT_PUBLIC_SUPPORTED_LOCALES=ru,en

# Android App Links. SHA-256 fingerprints are comma-separated.
ANDROID_PACKAGE_NAME=ru.aegisarena.app
ANDROID_APP_SHA256=

# Steam Web API (ники/аватарки). https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# --- Postgres / Redis / MinIO (имена сервисов docker-сети) ---
DATABASE_URL=postgresql://postgres:postgres@postgres2:5432/mediagame?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@postgres2:5432/mediagame?schema=public
REDIS_URL=redis://redis2:6379
S3_ENDPOINT=http://minio2:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=media-game-cup
# Optional absolute directory. Empty uses .data/media under the app directory.
LOCAL_MEDIA_DIR=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mediagame

# --- realtime ---
NEXT_PUBLIC_SOCKET_URL=http://localhost:3003
REALTIME_PORT=3003
REALTIME_INTERNAL_URL=http://realtime2:3003

# --- тик: web=1, tick2 в compose ставит 0 ---
TOURNAMENT_TICK_MS=60000
DISABLE_TOURNAMENT_TICK=1
TOURNAMENT_TICK_UNREF=0

PYTHON_BIN=python3

# Внутренний токен web ↔ realtime ↔ gc. Не пароль Steam.
DOTA_GC_INTERNAL_TOKEN=replace-with-a-long-random-token
APP_INTERNAL_URL=http://web2:3000
GC_SERVICE_PORT=8080
DOTA_GC_REFRESH_TOKEN_FILE=/data/refresh-token

# --- заполняет человек, если нужна фича ---
TELEGRAM_BOT_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_ID=
DISCORD_SECRET=

# GC protobuf гильдий — не заполнять до живого ответа координатора.
DOTA_GC_BOT_ACCOUNT_NAME=
DOTA_GC_BOT_REFRESH_TOKEN=
DOTA_GC_BOT_PASSWORD=
DOTA_GC_BOT_TWO_FACTOR_CODE=

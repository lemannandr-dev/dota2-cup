# Test environment. Use an isolated database and Redis instance.
NODE_ENV=test
NEXTAUTH_URL=http://localhost:3002
APP_URL=http://localhost:3002
AUTH_SECRET=test-only-secret-change-me-32-characters
NEXTAUTH_SECRET=test-only-secret-change-me-32-characters
NEXT_PUBLIC_APP_NAME="Aegis Arena Test"
NEXT_PUBLIC_DEFAULT_LOCALE=ru
NEXT_PUBLIC_SUPPORTED_LOCALES=ru,en
STEAM_API_KEY=

DATABASE_URL=postgresql://postgres:postgres@localhost:5544/aegis_test?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5544/aegis_test?schema=public
REDIS_URL=redis://localhost:6581
S3_ENDPOINT=http://localhost:9202
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test-only-secret
S3_BUCKET=aegis-test
LOCAL_MEDIA_DIR=.data/test-media
DOTA_GC_INTERNAL_TOKEN=test-only-gc-token-change-me-32-characters
NEXT_PUBLIC_SOCKET_URL=http://localhost:3003
REALTIME_PORT=3003
REALTIME_INTERNAL_URL=http://localhost:3003
DISABLE_TOURNAMENT_TICK=1
TOURNAMENT_TICK_UNREF=1
PYTHON_BIN=python3
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aegis_test

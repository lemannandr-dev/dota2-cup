# Production deployment environment. Copy into the deployment secret store, not into git.
# Steam OpenID login does not require STEAM_API_KEY; profile enrichment does.
NODE_ENV=production
NEXTAUTH_URL=https://arena.example.com
APP_URL=https://arena.example.com
AUTH_SECRET=generate-a-long-random-production-secret
NEXTAUTH_SECRET=generate-a-long-random-production-secret
LOG_LEVEL=info
NODE_OPTIONS=--max-old-space-size=4096

NEXT_PUBLIC_APP_NAME="Aegis Arena"
NEXT_PUBLIC_DEFAULT_LOCALE=ru
NEXT_PUBLIC_SUPPORTED_LOCALES=ru,en
ANDROID_PACKAGE_NAME=ru.aegisarena.app
ANDROID_APP_SHA256=
STEAM_API_KEY=replace-with-steam-web-api-key

DATABASE_URL=postgresql://production-user:replace-password@postgres:5432/mediagame?schema=public
DIRECT_DATABASE_URL=postgresql://production-user:replace-password@postgres:5432/mediagame?schema=public
POSTGRES_USER=production-user
POSTGRES_PASSWORD=replace-with-production-postgres-password
POSTGRES_DB=mediagame

REDIS_URL=redis://redis:6379
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-with-production-s3-access-key
S3_SECRET_KEY=replace-with-production-s3-secret-key
S3_BUCKET=media-game-cup
LOCAL_MEDIA_DIR=/app/.data/media

NEXT_PUBLIC_SOCKET_URL=https://arena.example.com
REALTIME_PORT=3003
REALTIME_INTERNAL_URL=http://realtime:3003
TOURNAMENT_TICK_MS=60000
DISABLE_TOURNAMENT_TICK=1
TOURNAMENT_TICK_UNREF=0
PYTHON_BIN=python3

DOTA_GC_INTERNAL_TOKEN=generate-a-long-random-internal-token
APP_INTERNAL_URL=http://web:3000
GC_SERVICE_PORT=8080
DOTA_GC_REFRESH_TOKEN_FILE=/data/refresh-token

TELEGRAM_BOT_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_ID=
DISCORD_SECRET=
DOTA_GC_BOT_ACCOUNT_NAME=
DOTA_GC_BOT_REFRESH_TOKEN=
DOTA_GC_BOT_PASSWORD=
DOTA_GC_BOT_TWO_FACTOR_CODE=

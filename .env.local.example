# Host development environment for Windows.
# Start Postgres/Redis/MinIO with docker-compose.second.yml, then run Next on the host.
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_SECRET=replace-with-a-long-random-string
NODE_ENV=development
LOG_LEVEL=info
NODE_OPTIONS=--max-old-space-size=4096

NEXT_PUBLIC_APP_NAME="Aegis Arena"
NEXT_PUBLIC_DEFAULT_LOCALE=ru
NEXT_PUBLIC_SUPPORTED_LOCALES=ru,en
ANDROID_PACKAGE_NAME=ru.aegisarena.app
ANDROID_APP_SHA256=
STEAM_API_KEY=

DATABASE_URL=postgresql://postgres:postgres@localhost:5434/mediagame?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/mediagame?schema=public
REDIS_URL=redis://localhost:6381
S3_ENDPOINT=http://localhost:9102
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=media-game-cup
LOCAL_MEDIA_DIR=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mediagame

NEXT_PUBLIC_SOCKET_URL=http://localhost:3003
REALTIME_PORT=3003
REALTIME_INTERNAL_URL=http://localhost:3003
TOURNAMENT_TICK_MS=60000
DISABLE_TOURNAMENT_TICK=0
TOURNAMENT_TICK_UNREF=0
PYTHON_BIN=python3
DOTA_GC_INTERNAL_TOKEN=replace-with-a-long-random-token
APP_INTERNAL_URL=http://localhost:3000
GC_SERVICE_PORT=8080
DOTA_GC_REFRESH_TOKEN_FILE=./refresh-token

TELEGRAM_BOT_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_ID=
DISCORD_SECRET=
DOTA_GC_BOT_ACCOUNT_NAME=
DOTA_GC_BOT_REFRESH_TOKEN=
DOTA_GC_BOT_PASSWORD=
DOTA_GC_BOT_TWO_FACTOR_CODE=
